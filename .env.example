# Copy this file to ".env" and put your real token there. Never commit ".env".
# Create a token at https://huggingface.co/settings/tokens (a "Read" token is enough;
# for Inference Providers, enable permission to make calls to Inference Providers).
HF_TOKEN=your_huggingface_token_here

# Optional: choose a different chat model served by Hugging Face Inference Providers.
# HF_MODEL=openai/gpt-oss-120b
